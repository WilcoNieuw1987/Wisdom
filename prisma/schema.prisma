// Wisdom — persoonlijk aantekeningenboekje voor werk
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Eén aantekening: een idee, een frustratie om van je af te schrijven, of een gewone notitie.
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  /// type: "idee" | "frustratie" | "notitie"
  type      String   @default("notitie")
  category  String?
  /// komma-gescheiden labels, bijv. "klant,proces,urgent"
  tags      String   @default("")
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([archived])
  @@index([createdAt])
}
